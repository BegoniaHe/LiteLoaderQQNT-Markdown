{
    "compilerOptions": {
        "paths": {
            "@/*": [
                "./src/*"
            ]
        },
        "outDir": "./dist",
        "noImplicitAny": true,
        "jsx": "react",
        "allowJs": true,
        "target": "ES2021",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "types": ["node"]
    },
    "exclude": [
        "./dist/**/*",
        "node_modules"
    ]
}