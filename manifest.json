{
    "manifest_version": 4,
    "type": "extension",
    "name": "Markdown-it",
    "slug": "markdown_it_v4",
    "icon": "./icon.png",
    "description": "为 QQNT 提供 Markdown 渲染",
    "version": "2.4.1",
    "authors": [
        {
            "name": "BegoniaHe",
            "link": "https://github.com/BegoniaHe"
        }
    ],
    "repository": {
        "repo": "BegoniaHe/LiteLoaderQQNT-Markdown",
        "branch": "v4",
        "release": {
            "tag": "2.4.1",
            "file": "Release.zip"
        }
    },
    "platform": [
        "win32",
        "linux",
        "darwin"
    ],
    "injects": {
        "renderer": "./dist/renderer.js",
        "main": "./dist/main.js",
        "preload": "./dist/preload.js"
